# Local development defaults. Copy to .env or run ./bootstrap.sh.
COMPOSE_PROJECT_NAME=nexusforever

# Use your LAN/public IPv4 for clients on other machines.
REALM_HOST=127.0.0.1
REALM_NAME=NexusForever
GAME_BIND_ADDRESS=0.0.0.0
AUTH_PORT=23115
STS_PORT=6600
WORLD_PORT=24000

# Optional client folder or Patch folder, used to extract missing/incompatible assets.
CLIENT_PATH=
# Paths are relative to this checkout.
MAP_PATH=../map
TBL_PATH=../tbl
DATA_PATH=./data

# After first startup, change passwords in the web UIs too. See docker/README.md.
MYSQL_ROOT_PASSWORD=nexusforever-root
MYSQL_PASSWORD=nexusforever
RABBITMQ_USER=nexusforever
RABBITMQ_PASSWORD=nexusforever

# Only used when creating the account.
GAME_ACCOUNT_EMAIL=admin@example.com
GAME_ACCOUNT_PASSWORD=nexusforever
GAME_ACCOUNT_ROLE=Administrator

ADMIN_BIND_ADDRESS=127.0.0.1
PHPMYADMIN_PORT=8080
RABBITMQ_MANAGEMENT_PORT=15672
WORLD_CONSOLE_PORT=5000

DOTNET_VERSION=10.0
MYSQL_IMAGE=mysql:8.4
RABBITMQ_IMAGE=rabbitmq:4.3-management
PHPMYADMIN_IMAGE=phpmyadmin:5.2-apache
# Must match the server schema. See docker/README.md before updating.
WORLD_DATABASE_REF=79d836576b9da8d7f7321ec3463d3673d496f090
